# Copy this file to backend/.env and fill in real values.
# Never commit .env to git.

# ---- Supabase ----
# Project URL from Supabase Dashboard > Settings > API
# If login shows [Errno 11001] getaddrinfo failed, this host does not resolve
# (project paused/deleted or typo). Fix SUPABASE_URL and restart the API.
# Offline signup/login works automatically while Supabase is unreachable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_ID=your_supabase_project_id
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Prefer classic anon + service_role JWTs (eyJ...), or new publishable/secret keys
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key
# JWT secret (also used for offline local tokens)
JWT_SECRET=your_supabase_jwt_secret

# ---- Qdrant Cloud ----
QDRANT_URL=https://YOUR_CLUSTER_ID.REGION.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ---- LLM providers ----
GROQ_API_KEY=gsk_your_groq_key_here
GOOGLE_API_KEY=your_google_ai_studio_key

# ---- RAG ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
USE_LOCAL_VECTOR_STORE=true
LOCAL_EMBEDDINGS_DIR=G:\Hackathon\embeddings
LOCAL_CORPUS_DIR=G:\Hackathon\corpus

# ---- App ----
PROJECT_NAME=VakeelLink API
API_V1_STR=/api/v1
ENVIRONMENT=development

# Production frontend origins (comma-separated). Used by CORS on Render.
# Example: https://vakeellink.vercel.app,https://your-domain.com
CORS_ORIGINS=

# Skip Supabase Auth (avoids free-tier email rate limit). false = prefer Supabase.
AUTH_PREFER_LOCAL=true

